<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"/>

    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- To -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/compose_to" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/et_to" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textEmailAddress"
                android:hint="To" android:layout_marginBottom="8dp"/>

            <!-- Cc -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/compose_cc" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/et_cc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textEmailAddress"
                android:hint="Cc" android:layout_marginBottom="8dp"/>

            <!-- Bcc -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/compose_bcc" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/et_bcc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textEmailAddress"
                android:hint="Bcc" android:layout_marginBottom="8dp"/>

            <!-- Subject -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/compose_subject" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/et_subject" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <!-- Attachments -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/compose_attach"
                    android:textStyle="bold" android:textSize="12sp" android:layout_gravity="center_vertical"/>

                <Button android:id="@+id/btn_add_attachment"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/compose_add_file"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/attachment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"/>

            <!-- Body -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Mesaj:" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/et_body" android:layout_width="match_parent"
                android:layout_height="200dp" android:gravity="top"
                android:inputType="textMultiLine" android:layout_marginBottom="16dp"/>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btn_send"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/compose_send"
                    android:backgroundTint="@color/primary" android:textColor="#FFFFFF"/>

                <Button android:id="@+id/btn_discard"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/compose_discard"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
